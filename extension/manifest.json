{
  "manifest_version": 3,
  "name": "Motor Senior",
  "version": "0.13.6",
  "version_name": "0.13.6 - Coleta profunda de 1 a 3 concorrentes antes do retorno",
  "minimum_chrome_version": "114",
  "description": "Motor técnico do Gestor Sênior para coleta da Shopee, concorrentes, Ads, custos e sincronização com a Super Análise exibida no site.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "alarms", "notifications", "sidePanel", "scripting", "downloads", "clipboardWrite"],
  "host_permissions": ["https://shopee.com.br/*", "https://*.shopee.com.br/*", "https://seller.shopee.com.br/*", "https://*.shopeemobile.com/*", "https://shopeeos-real.vercel.app/*", "https://shopeeos-real-greskgja.vercel.app/*"],
  "icons": {"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"},
  "background": {"service_worker":"src/background-web.js","type":"module"},
  "action": {"default_title":"Motor Senior","default_icon":{"16":"icons/icon16.png","32":"icons/icon32.png","48":"icons/icon48.png","128":"icons/icon128.png"}},
  "side_panel": {"default_path":"engine-status.html"},
  "content_scripts": [
    {"matches":["https://shopee.com.br/*"],"js":["src/collector-interceptor.js","src/page-hook.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://seller.shopee.com.br/*","https://*.shopee.com.br/*"],"js":["src/page-hook.js"],"run_at":"document_start","world":"MAIN"},
    {"matches":["https://shopee.com.br/*"],"js":["src/gestor-guided-redirect.js","src/content.js","src/collector-content.js","src/competitor-picker-content.js","src/competitor-picker-reload.js","src/competitor-deep-content.js"],"run_at":"document_start","world":"ISOLATED"},
    {"matches":["https://seller.shopee.com.br/*","https://*.shopee.com.br/*"],"js":["src/content.js","src/competitor-deep-content.js"],"run_at":"document_start","world":"ISOLATED"},
    {"matches":["https://shopeeos-real.vercel.app/*","https://shopeeos-real-greskgja.vercel.app/*"],"js":["src/gestor-bridge.js"],"run_at":"document_start","world":"ISOLATED","all_frames":true}
  ],
  "web_accessible_resources": [{"resources":["src/lib/shopee-parser.js"],"matches":["https://shopee.com.br/*","https://*.shopee.com.br/*","https://seller.shopee.com.br/*"]}]
}