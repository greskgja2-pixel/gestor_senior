{
  "manifest_version": 3,
  "name": "Gestor Sênior — Shopee Intelligence",
  "version": "0.8.0",
  "version_name": "0.8.0 - Mini tutoriais interativos",
  "minimum_chrome_version": "114",
  "description": "Extensão unificada do Gestor Sênior: Super Anúncio, Shopee Ads, dashboard analítica, melhoria contínua, ações em massa, automações protegidas, mini tutoriais, Auto Mapper v2.4 e Coletor Shopee v3.1.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "alarms", "notifications", "sidePanel", "scripting", "downloads", "clipboardWrite"],
  "host_permissions": [
    "https://shopee.com.br/*",
    "https://*.shopee.com.br/*",
    "https://seller.shopee.com.br/*",
    "https://*.shopeemobile.com/*",
    "https://shopeeos-real.vercel.app/*",
    "https://shopeeos-real-greskgja.vercel.app/*"
  ],
  "icons": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"},
  "background": {"service_worker": "src/background.js", "type": "module"},
  "action": {"default_title": "Gestor Sênior", "default_icon": {"16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png"}},
  "side_panel": {"default_path": "sidepanel-v3.html"},
  "content_scripts": [
    {"matches": ["https://shopee.com.br/*"], "js": ["src/collector-interceptor.js", "src/page-hook.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://seller.shopee.com.br/*", "https://*.shopee.com.br/*"], "js": ["src/page-hook.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://shopee.com.br/*"], "js": ["src/content.js", "src/collector-content.js"], "run_at": "document_start", "world": "ISOLATED"},
    {"matches": ["https://seller.shopee.com.br/*", "https://*.shopee.com.br/*"], "js": ["src/content.js"], "run_at": "document_start", "world": "ISOLATED"}
  ],
  "web_accessible_resources": [{"resources": ["src/lib/shopee-parser.js"], "matches": ["https://shopee.com.br/*", "https://*.shopee.com.br/*", "https://seller.shopee.com.br/*"]}]
}
