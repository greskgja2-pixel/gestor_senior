{
  "manifest_version": 3,
  "name": "Gestor Sênior — Shopee Intelligence",
  "version": "0.1.0",
  "version_name": "0.1.0 - Fundação unificada",
  "minimum_chrome_version": "114",
  "description": "Extensão companheira do Gestor Sênior: análise Super Anúncio, Shopee Ads, Proteção de ROAS, automações e coleta técnica.",
  "permissions": ["storage", "unlimitedStorage", "tabs", "alarms", "notifications", "sidePanel", "scripting"],
  "host_permissions": ["https://shopee.com.br/*", "https://*.shopee.com.br/*", "https://seller.shopee.com.br/*", "https://*.shopeemobile.com/*", "https://shopeeos-real.vercel.app/*"],
  "background": {"service_worker": "src/background.js", "type": "module"},
  "action": {"default_title": "Gestor Sênior"},
  "side_panel": {"default_path": "sidepanel.html"},
  "content_scripts": [
    {"matches": ["https://seller.shopee.com.br/*", "https://shopee.com.br/*", "https://*.shopee.com.br/*"], "js": ["src/page-hook.js"], "run_at": "document_start", "world": "MAIN"},
    {"matches": ["https://seller.shopee.com.br/*", "https://shopee.com.br/*", "https://*.shopee.com.br/*"], "js": ["src/content.js"], "run_at": "document_start", "world": "ISOLATED"}
  ],
  "web_accessible_resources": [{"resources": ["src/lib/shopee-parser.js"], "matches": ["https://shopee.com.br/*", "https://*.shopee.com.br/*", "https://seller.shopee.com.br/*"]}]
}
