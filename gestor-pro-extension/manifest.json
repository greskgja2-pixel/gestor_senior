{
  "manifest_version": 3,
  "name": "Gestor Pro",
  "version": "0.1.0",
  "description": "Laboratório isolado de inteligência da busca Shopee; T01 experimental.",
  "permissions": [],
  "host_permissions": [
    "https://shopee.com.br/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://shopee.com.br/search*",
        "https://shopee.com.br/search?*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "intercept.js"
      ],
      "matches": [
        "https://shopee.com.br/*"
      ]
    }
  ]
}
